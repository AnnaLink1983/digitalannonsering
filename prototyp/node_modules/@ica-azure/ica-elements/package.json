{
  "name": "@ica-azure/ica-elements",
  "version": "20.15.1",
  "description": "Ica Elements UI components",
  "scripts": {
    "prebuild": "rimraf dist && mkdirp dist",
    "build": "npm run types && npm run bundle-sass && npm run build:fonts && npm run copy && rollup --config",
    "build:icons": "node ./scripts/icons/buildIcaIcons.js",
    "bundle": "rollup --config rollup-lib.config.js",
    "dev": "npm run build -- --watch",
    "dev:bundle": "cross-env NODE_ENV=production npm run build && npm run bundle && serve dist --cors",
    "copy": "cpy package.json dist && cpy src/common/ui/_ui__colors.scss dist --rename=color-variables.scss && cpy src/common/layout/_layout_breakpoints.scss dist --rename=layout-breakpoints.scss",
    "start": "run-p build storybook",
    "test": "npm run test:scripts && npm run test:rollup && karma start",
    "test:watch": "karma start --auto-watch=true --single-run=false --reporters=progress",
    "test:scripts": "mocha --require esm \"scripts/*.test.js\"",
    "test:rollup": "mocha --require esm \"rollup/*.test.js\"",
    "prelink": "cpy .npmrc dist && node scripts/cleanPackageJsonBeforeLink.js",
    "link": "cd dist && npm link",
    "unlink": "cd dist && npm unlink",
    "storybook": "storybook dev -s ../dist -p 1337",
    "storybook:build": "cross-env NODE_ENV=test npm run build && storybook build -s ./dist -o .storybook-build && node scripts/changeIframeToIncludeTypeModule.js && node scripts/createZip.js",
    "storybook:docker-build": "docker build -f Dockerfile.storybook -t docker-static .",
    "storybook:docker-run": "docker run --name docker-static -p 1234:90 docker-static",
    "storybook:docker-stop": "docker container stop $(docker container ls -q --filter name=docker-static)",
    "storybook:docker-rm": "docker rm /docker-static",
    "lint": "eslint src --ext .js,.svelte",
    "create-component": "hygen component with-prompt",
    "create-icon": "hygen icon with-prompt",
    "preversion": "npm test",
    "release": "sh ./scripts/release.sh",
    "build:fonts": "cross-env NODE_ENV=production gulp",
    "types": "node types.mjs",
    "bundle-sass": "node bundleSass.mjs",
    "prepare": "husky"
  },
  "browserslist": [
    "last 2 iOS versions",
    "last 2 Safari versions"
  ],
  "devDependencies": {
    "@babel/core": "7.10.3",
    "@babel/polyfill": "7.10.1",
    "@babel/preset-env": "7.10.3",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@ica-azure/eslint-plugin-ica-elements": "^2.0.9",
    "@ica-azure/ica-brinejs": "^0.1.8",
    "@ica-azure/minbutik-pattern-library": "1.0.2",
    "@ica-azure/sveltedoc-parser": "3.0.6",
    "@ica/ids-core": "^9.4.0",
    "@open-wc/testing": "2.5.33",
    "@open-wc/testing-karma": "3.4.5",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-replace": "5.0.2",
    "@rollup/plugin-terser": "^0.4.0",
    "@storybook/addon-a11y": "7.6.18",
    "@storybook/addon-docs": "^7.6.18",
    "@storybook/addon-links": "7.6.18",
    "@storybook/addon-storyshots": "7.6.18",
    "@storybook/addon-storysource": "7.6.18",
    "@storybook/addon-viewport": "7.6.18",
    "@storybook/source-loader": "7.6.18",
    "@storybook/web-components-webpack5": "^7.6.18",
    "@testing-library/dom": "7.17.1",
    "@testing-library/user-event": "11.3.1",
    "archiver": "4.0.1",
    "autoprefixer": "9.8.4",
    "babel-eslint": "10.1.0",
    "babel-loader": "8.1.0",
    "babel-plugin-require-context-hook": "1.0.0",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "bundle-scss": "^1.5.1",
    "chalk": "4.1.0",
    "change-case": "4.1.1",
    "core-js": "3.6.5",
    "cpy-cli": "3.1.1",
    "cross-env": "7.0.2",
    "cssnano": "4.1.10",
    "doiuse": "4.2.0",
    "dotenv": "8.2.0",
    "eslint": "7.3.1",
    "eslint-config-prettier": "6.11.0",
    "eslint-plugin-mocha": "7.0.1",
    "eslint-plugin-svelte3": "3.3.0",
    "esm": "3.2.25",
    "faker": "4.1.0",
    "fs-plus": "^3.1.1",
    "glob": "8.1.0",
    "gulp": "4.0.2",
    "gulp-autoprefixer": "7.0.1",
    "gulp-clean-css": "4.2.0",
    "gulp-sass": "5.0.0",
    "gulp-sourcemaps": "2.6.5",
    "highlight.js": "10.1.1",
    "husky": "^9.0.11",
    "hygen": "5.0.3",
    "karma-browserify": "8.1.0",
    "lint-staged": "10.2.11",
    "lit-html": "1.2.1",
    "marked": "1.1.0",
    "mkdirp": "1.0.4",
    "node-notifier": "^10.0.1",
    "npm-run-all": "4.1.5",
    "parse5": "5.1.1",
    "post-npm-install": "2.0.0",
    "postcss": "7.0.32",
    "prettier": "2.0.5",
    "prettier-plugin-svelte": "2.10.1",
    "rimraf": "3.0.2",
    "rollup": "2.79.1",
    "rollup-plugin-scss": "3.0.0",
    "rollup-plugin-svelte": "^7.1.4",
    "rollup-plugin-svg-import": "1.5.1",
    "sass": "1.35.1",
    "serve": "^14.2.0",
    "shelljs": "^0.8.4",
    "sinon": "9.0.2",
    "sinon-chai": "3.7.0",
    "storybook": "^7.6.18",
    "svelte": "3.57.0",
    "svgo": "^3.2.0",
    "typescript": "^5.0.4",
    "watchify": "3.11.1",
    "webpack-merge": "^5.10.0",
    "svelte-popperjs": "^1.3.2"
  },
  "lint-staged": {
    "*.{js,css,json,md,svelte}": [
      "prettier --write --plugin-search-dir=."
    ],
    "*.{js,svelte}": "eslint"
  },
  "dependencies": {
    "@webcomponents/webcomponentsjs": "^2.7.0",
    "flatpickr": "^4.6.13"
  }
}
